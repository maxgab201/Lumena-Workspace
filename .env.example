# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Server-side secrets (set via `supabase secrets set`, never in this file):
# GEMINI_API_KEY       - required by ai-gateway, process-document, rag-retrieve, generate-knowledge
# OPENAI_API_KEY       - optional, enables OpenAIProvider in ai-gateway
# STRIPE_SECRET_KEY    - required by create-checkout-session, stripe-webhook
# STRIPE_WEBHOOK_SECRET- required by stripe-webhook

# Feature flags (build time). Off unless set to "true" or "1". A feature that is off makes no
# request to its backend. Presentations is "Soon": its table does not exist in production yet.
# VITE_FEATURE_PRESENTATIONS=false
